{
  "name": "basile-agc",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-driven, reproducible AGC configuration generator",
  "type": "module",
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test",
    "format": "bun --bun oxfmt --write .",
    "format:check": "bun --bun oxfmt --check .",
    "generate": "bun src/cli.ts generate",
    "lint": "bun --bun oxlint --type-aware --max-warnings 0 .",
    "release:ci": "bun src/release/run.ts",
    "test": "bun test",
    "typecheck": "bun --bun tsc --noEmit",
    "validate": "bun src/cli.ts validate",
    "verify": "bun src/verify.ts",
    "video:cadence": "bun src/video/cli.ts"
  },
  "dependencies": {
    "effect": "4.1.4",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "eslint-plugin-jsdoc": "65.4.12",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
