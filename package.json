{
  "name": "basile-agc",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-driven, reproducible AGC configuration generator",
  "type": "module",
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "generate": "bun src/cli.ts generate",
    "lint": "oxlint --type-aware --max-warnings 0 .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "validate": "bun src/cli.ts validate"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "eslint-plugin-jsdoc": "65.4.12",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22.13.0"
  },
  "packageManager": "bun@1.4.4"
}
